# Base URL for canonical tags and sitemap (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://unitflow.jp

# Your eBay Store URL
NEXT_PUBLIC_EBAY_STORE_URL=https://www.ebay.com/str/YOUR_EBAY_STORE

# Sedora API（在庫と写真の取得元）
# 例: SEDORA_API_URL=https://<sedora の URL>/api/public/products
# SEDORA_API_KEY は sedora 側の UNITFLOW_API_KEY と同じ値
# 本番で未設定・取得失敗のときは在庫 0 件を表示する（見本データは出さない）
SEDORA_API_URL=
SEDORA_API_KEY=
# 本番でも見本データを出したいときだけ true（通常は入れない）
# USE_SAMPLE_PRODUCTS=true

# Contact form (Resend)
RESEND_API_KEY=
